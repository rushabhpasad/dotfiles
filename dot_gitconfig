# This is Git's per-user configuration file.
[user]
	name = Rushabh Pasad
	email = rushabh@samyaktechlabs.com
	signingKey = 27F63F9E37333E1AF248F23467B1C5F19E1AF77D
[includeIf "gitdir:/Users/rpasad/testlify/"]
	path = ~/.gitconfig-testlify
[push]
    default = simple
[color]
    ui = true
[core]
	excludesfile = /Users/rpasad/.gitignore_global
[alias]
    logg = log --graph --decorate --oneline --abbrev-commit --all
    st = status
[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
[init]
	defaultBranch = main
[commit]
	template = /Users/rpasad/.stCommitMsg
	gpgSign = true
[gpg]
	program = /opt/homebrew/bin/gpg
	format = openpgp
[tag]
	forceSignAnnotated = true
[gpg "ssh"]
	program = 
	allowedSignersFile = 
[credential]
	helper = osxkeychain
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
